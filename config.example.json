{
  "logLevel": "info",
  "cubyz": {
    "host": "127.0.0.1",
    "port": 47649,
    "botName": "Discord",
    "version": "0.0.0"
  },
  "integration": {
    "cubyzlistSite": {
      "enabled": false,
      "endpoint": "https://servers.ashframe.net",
      "token": "PASTE_YOUR_RELAY_TOKEN_HERE"
    }
  },
  "discord": {
    "enabled": true,
    "token": "YOUR_DISCORD_BOT_TOKEN",
    "channelId": "YOUR_CHANNEL_ID",
    "allowedMentions": [],
    "enableReactions": true,
    "enableReplies": true
  },
  "events": ["join", "leave", "death", "chat"],
  "censorlist": [],
  "startupMessages": [],
  "startupMessageDelay": 0,
  "excludeBotFromCount": true,
  "excludedUsernames": [],
  "chatPatterns": {
    "chat": {
      "pattern": "^\\[(?<username>.+?)\\]\\s*(?<message>[\\s\\S]*)$"
    },
    "join": {
      "pattern": "^(?<username>.+?) joined$"
    },
    "leave": {
      "pattern": "^(?<username>.+?) left$"
    },
    "death": {
      "pattern": "^(?<username>.+?) died(?<message>.*)$"
    }
  },
  "connection": {
    "reconnect": true,
    "maxRetries": 0,
    "retryDelayMs": 30000
  }
}
